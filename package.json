{
  "name": "forge",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && tsc -b && vite build && node scripts/assemble.mjs",
    "build:native": "vite build --mode native && npx cap sync",
    "apk": "cp src/lib/portions.json native/app/src/main/assets/portions.json && cp public/food-catalog.json native/app/src/main/assets/food-catalog.json && cd native && JAVA_HOME=$HOME/.local/jdk-21 ./gradlew -q :app:assembleRelease && cp app/build/outputs/apk/release/app-release.apk ../release/forge.apk",
    "apk:web-wrapper": "npm run build:native && node scripts/build-apk.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "catalog": "node scripts/rebuild-catalog.mjs",
    "deploy": "vercel build --prod && vercel deploy --prebuilt --prod --yes",
    "sim:pool": "node scripts/simulate-shared-pool.mjs",
    "test:db": "node scripts/test-live-db.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/supabase-js": "^2.114.0",
    "date-fns": "^4.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "gsap": "^3.15.0",
    "happy-dom": "^21.0.4",
    "lenis": "^1.3.26",
    "oxlint": "^1.79.0",
    "pg": "^8.23.0",
    "puppeteer-core": "^25.9.0",
    "supabase": "^2.116.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
