# ---------------------------------------------------------------------------
# FORGE environment. Copy to .env.local and fill in. Never commit real values.
# ---------------------------------------------------------------------------

# Supabase (browser). Use the PUBLISHABLE / anon key here — never the service-role key.
# Project settings -> API. Leaving these blank runs FORGE fully on-device (demo mode).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: override where the AI Edge Function lives.
# Defaults to ${VITE_SUPABASE_URL}/functions/v1/ai when unset.
VITE_AI_FUNCTION_URL=

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY — these are set as Supabase Edge Function secrets, never here
# and never in the browser bundle:
#   supabase secrets set GEMINI_API_KEY_1=... GEMINI_API_KEY_2=... GEMINI_API_KEY_3=...
#
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_MODEL=gemini-2.5-flash      # optional override
# ALLOWED_ORIGIN=https://your-app.example   # optional CORS lock-down
#
# Optional external nutrition sources (not required — FORGE works without them):
# NUTRITION_API_KEY=
# FOOD_DATABASE_API_KEY=
# ---------------------------------------------------------------------------
