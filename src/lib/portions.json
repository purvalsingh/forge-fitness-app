    {
      "match": "^(desi )?ghee\\b(?!\\s+(rice|roast|dosa|chicken|masala|paratha))",
      "tsp": 5,
      "tbsp": 15,
      "default_unit": "tsp",
      "fat": true
    },
    {
      "match": "^(cooking |mustard |coconut |groundnut |sunflower )?(oil|tel|butter|makhan|white butter)\\b(?!\\s+(chicken|masala|paneer|naan|garlic|roti|dal|milk|paratha|scotch|cookie|biscuit))",
