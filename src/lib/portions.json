      "home_cooked": true
    },
    {
      "match": "\\b(paneer butter masala|butter chicken|kadai|tikka masala|shahi paneer|dal makhani)\\b",
      "katori": 150,
      "default_unit": "katori",
      "home_cooked": true,
      "restaurant": true
    },
    {
      "match": "\\b(rice|chawal|bhaat|bhat|pulao|jeera rice|khichdi|khichadi)\\b",
